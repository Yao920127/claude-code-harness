{
  "name": "@deepseek-ai/dsh-web-search-claude-code",
  "description": "Claude Code search provider (built-in WebSearch with the host's Claude Code sign-in) for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-subagent-claude-code": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.291",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subagent-claude-code": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
